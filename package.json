{
  "name": "paperclip-plugin-discord",
  "version": "0.10.0",
  "type": "module",
  "main": "./dist/index.js",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "version": "node scripts/sync-plugin-version.mjs && git add src/constants.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "*",
    "@paperclipai/shared": "*"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "prism-media": "^1.3.5",
    "libsodium-wrappers": "^0.7.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.817.0",
    "@paperclipai/shared": "^2026.817.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "@types/ws": "^8.5.13",
    "@types/libsodium-wrappers": "^0.7.14"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvanhorn/paperclip-plugin-discord.git"
  },
  "license": "MIT"
}
